# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API
API_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sibling_archive

# Storage (S3-compatible; use AWS S3, Cloudflare R2, or Supabase Storage adapter)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=sibling-archive-private
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Email
RESEND_API_KEY=
FROM_EMAIL=hello@example.com

# Auth / signing
SESSION_SECRET=change-me
