generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Archive {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  slides    Slide[]

  @@index([slug])
}

model Slide {
  id        String   @id @default(cuid())
  archiveId String
  type      String   // PHOTO, QUESTION, BEFORE_AFTER, SIBLING_COURT, CHAT_SCREENSHOT
  position  Int
  data      Json     // Type-specific fields stored here
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archive   Archive  @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@index([archiveId, position])
  @@index([archiveId])
}
